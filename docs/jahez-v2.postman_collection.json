{
  "info": {
    "name": "Jahez V2 — Accounts, signed settlements and approvals",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "طلبات مستقلة للتجربة. لا تنفذ المجموعة كاملة على التشغيل. المعاينة لا تحفظ؛ التنفيذ والاعتماد والسداد يسجلون عمليات فعلية."
  },
  "variable": [
    { "key": "cashboxHandoverId", "value": "" },
    { "key": "cashboxHandoverRowVersion", "value": "" },
    {
      "key": "baseUrl",
      "value": "https://localhost:7112"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "accountId",
      "value": ""
    },
    {
      "key": "handoverId",
      "value": ""
    },
    {
      "key": "operationId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "debtId",
      "value": ""
    },
    {
      "key": "targetAccountId",
      "value": ""
    },
    {
      "key": "accountRowVersion",
      "value": ""
    },
    {
      "key": "operationRowVersion",
      "value": ""
    },
    {
      "key": "throughDate",
      "value": "2026-10-15"
    },
    {
      "key": "effectiveAtUtc",
      "value": "2026-10-15T10:00:00+03:00"
    },
    {
      "key": "riderProfileId",
      "value": ""
    },
    {
      "key": "batchId",
      "value": ""
    },
    {
      "key": "fileId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Accountant handovers — list",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/jahez/v2/cashbox/handovers?page=1&pageSize=50" }
    },
    {
      "name": "Accountant handover — details",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/jahez/v2/cashbox/handovers/{{cashboxHandoverId}}" }
    },
    {
      "name": "Submit funds to accountant — creates pending snapshot",
      "request": { "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Idempotency-Key", "value": "{{$guid}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/jahez/v2/cashbox/handovers",
        "body": { "mode": "raw", "raw": "{\n  \"businessDate\": \"2026-10-17\",\n  \"reason\": \"تسليم الأموال للمحاسب\"\n}" } }
    },
    {
      "name": "Accountant confirms funds — clears only included movements",
      "request": { "method": "POST",
        "description": "Use a different accountant's token and the exact per-fund amounts/rowVersion from the pending handover. The example amounts are illustrative. Confirmation clears outstanding totals only for the fixed submitted movement set.",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Idempotency-Key", "value": "{{$guid}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/jahez/v2/cashbox/handovers/{{cashboxHandoverId}}/confirm",
        "body": { "mode": "raw", "raw": "{\n  \"cashboxAmount\": 50,\n  \"petroAppAmount\": 75,\n  \"bankAmount\": -20,\n  \"reason\": \"تم الاستلام والمطابقة\",\n  \"rowVersion\": \"{{cashboxHandoverRowVersion}}\"\n}" } }
    },
    {
      "name": "Submitter cancels pending accountant handover",
      "request": { "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Idempotency-Key", "value": "{{$guid}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/jahez/v2/cashbox/handovers/{{cashboxHandoverId}}/cancel",
        "body": { "mode": "raw", "raw": "{\n  \"reason\": \"إلغاء وإعادة المطابقة\",\n  \"rowVersion\": \"{{cashboxHandoverRowVersion}}\"\n}" } }
    },
    {
      "name": "جميع الحسابات — بدون فلاتر",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/jahez/v2/accounts?page=1&pageSize=50"
      }
    },
    {
      "name": "تفاصيل الحساب وتاريخه",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/jahez/v2/accounts/{{accountId}}?page=1&pageSize=50"
      }
    },
    {
      "name": "المؤشرات والكفالات",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/jahez/v2/statistics"
      }
    },
    {
      "name": "تحديث الحالة",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}/api/jahez/v2/accounts/{{accountId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Suspended\",\n  \"reason\": \"إيقاف إداري\",\n  \"rowVersion\": \"{{accountRowVersion}}\"\n}"
        }
      }
    },
    {
      "name": "معاينة التصفية — لا أثر مالي",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/jahez/v2/operations/preview",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"handoverId\": \"{{handoverId}}\",\n  \"mode\": 1,\n  \"throughDate\": \"{{throughDate}}\",\n  \"effectiveAtUtc\": \"{{effectiveAtUtc}}\",\n  \"net\": -100,\n  \"reason\": \"تصفية من داشبورد جاهز\",\n  \"fund\": 1,\n  \"purpose\": 1,\n  \"transferToRider\": false,\n  \"paymentReference\": \"ACTUAL-RECEIPT-OR-TRANSFER\"\n}"
        }
      }
    },
    {
      "name": "حفظ تصفية دون سحب",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}/api/jahez/v2/operations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"handoverId\": \"{{handoverId}}\",\n  \"mode\": 1,\n  \"throughDate\": \"{{throughDate}}\",\n  \"effectiveAtUtc\": \"{{effectiveAtUtc}}\",\n  \"net\": -100,\n  \"reason\": \"تصفية من داشبورد جاهز\",\n  \"fund\": 1,\n  \"purpose\": 1,\n  \"transferToRider\": false,\n  \"paymentReference\": \"ACTUAL-RECEIPT-OR-TRANSFER\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===200) pm.collectionVariables.set(\"operationId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "تعديل المسودة وإعادة المعاينة",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}/api/jahez/v2/operations/{{operationId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"values\": {\n    \"handoverId\": \"{{handoverId}}\",\n    \"mode\": 1,\n    \"throughDate\": \"{{throughDate}}\",\n    \"effectiveAtUtc\": \"{{effectiveAtUtc}}\",\n    \"net\": -100,\n    \"reason\": \"تصفية من داشبورد جاهز\",\n    \"fund\": 1,\n    \"purpose\": 1,\n    \"transferToRider\": false,\n    \"paymentReference\": \"ACTUAL-RECEIPT-OR-TRANSFER\"\n  },\n  \"rowVersion\": \"{{operationRowVersion}}\"\n}"
        }
      }
    },
    {
      "name": "تنفيذ الحركة المالية الكاملة",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}/api/jahez/v2/operations/{{operationId}}/execute"
      }
    },
    {
      "name": "تعديل طريقة صرف تصفية منفذة — خزنة إلى بنك",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{$guid}}" }
        ],
        "url": "{{baseUrl}}/api/jahez/v2/operations/{{operationId}}/payment-method",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fund\": 3,\n  \"paymentReference\": \"BANK-TRANSFER-123\",\n  \"reason\": \"تصحيح طريقة صرف التصفية\",\n  \"rowVersion\": \"{{operationRowVersion}}\"\n}"
        },
        "description": "Executed payouts only. Use fund=1 to switch back to cashbox. Requires jahez.settle and jahez.money.disburse. Refresh operationRowVersion after each edit."
      }
    },
    {
      "name": "سجل العمليات",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/jahez/v2/operations?page=1&pageSize=50"
      }
    },
