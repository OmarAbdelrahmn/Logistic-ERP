            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"riderProfileId\": \"{{riderProfileId}}\",\n  \"effectiveAtUtc\": \"{{effectiveAtUtc}}\",\n  \"reason\": \"تسليم جديد\",\n  \"initialFeePayment\": 0\n}"
        }
      }
